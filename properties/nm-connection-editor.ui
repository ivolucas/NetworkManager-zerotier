<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="zerotier_editor_widget">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <property name="margin-top">12</property>
    <property name="margin-bottom">12</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <child>
      <object class="GtkLabel">
        <property name="label">Network ID</property>
        <property name="xalign">0</property>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="network_id_entry">
        <property name="max-length">16</property>
        <property name="placeholder-text">e.g. 8056c2e21c000001</property>
        <property name="hexpand">true</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="network_id_error_label">
        <property name="label">Network ID must be exactly 16 hex characters (0-9, a-f).</property>
        <property name="xalign">0</property>
        <property name="visible">false</property>
        <property name="wrap">true</property>
        <style>
          <class name="error"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkCheckButton" id="allow_default_check">
        <property name="label">Use this connection as the default route</property>
        <property name="margin-top">6</property>
      </object>
    </child>
  </object>
</interface>
